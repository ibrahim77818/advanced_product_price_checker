<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================ -->
    <!-- Kiosk configuration                                              -->
    <!-- ================================================================ -->
    <record id="product_checker_config_view_form" model="ir.ui.view">
        <field name="name">product.checker.config.form</field>
        <field name="model">product.checker.config</field>
        <field name="arch" type="xml">
            <form string="Price Checker Kiosk">
                <header>
                    <button name="action_open_kiosk" type="object" string="Open Kiosk"
                            class="oe_highlight" icon="fa-external-link"
                            invisible="not active"
                            groups="advanced_product_price_checker.group_price_checker_manager"/>
                    <button name="action_regenerate_token" type="object" string="Regenerate Token"
                            icon="fa-refresh"
                            confirm="Devices using the current link will stop working until they get the new URL. Continue?"
                            groups="advanced_product_price_checker.group_price_checker_manager"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                            invisible="active"/>
                    <field name="logo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Main Store - Entrance"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   options="{'no_create': True}"/>
                            <field name="company_id" invisible="1"/>
                            <field name="kiosk_url" widget="CopyClipboardChar"
                                   groups="advanced_product_price_checker.group_price_checker_manager"/>
                        </group>
                        <group>
                            <field name="default_lang_id" options="{'no_create': True}"/>
                            <field name="lang_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Pricing" name="pricing">
                            <field name="pricelist_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="company_id" column_invisible="True"/>
                                    <field name="pricelist_id" options="{'no_create': True}"/>
                                    <field name="label"/>
                                    <field name="currency_id" groups="base.group_multi_currency"/>
                                </list>
                            </field>
                            <div class="text-muted mb-3">
                                The first pricelist is displayed as the main price.
                                Without any line, the company's first pricelist is used.
                            </div>
                            <group>
                                <group>
                                    <field name="taxes_available" invisible="1"/>
                                    <field name="price_tax_mode" widget="radio"
                                           invisible="not taxes_available"/>
                                    <field name="show_discount"/>
                                </group>
                            </group>
                        </page>
                        <page string="Search" name="search">
                            <group>
                                <group string="Search By">
                                    <field name="search_barcode"/>
                                    <field name="search_packaging"/>
                                    <field name="search_default_code"/>
                                    <field name="search_name"/>
                                </group>
                                <group string="Input">
                                    <field name="search_min_chars"/>
                                    <field name="search_limit"/>
                                    <field name="keyboard_enabled"/>
                                    <field name="camera_enabled"/>
                                </group>
                            </group>
                            <group string="Products">
                                <field name="product_domain" widget="domain"
                                       options="{'model': 'product.product', 'in_dialog': True}"/>
                            </group>
                        </page>
                        <page string="Inventory" name="inventory">
                            <group>
                                <group>
                                    <field name="stock_display" widget="radio"/>
                                    <field name="stock_qty_mode" widget="radio"
                                           invisible="stock_display == 'hidden'"/>
                                    <field name="low_stock_threshold"
                                           invisible="stock_display == 'hidden'"/>
                                    <field name="show_variant_matrix"
                                           invisible="stock_display == 'hidden'"/>
                                </group>
                                <group invisible="stock_display == 'hidden'">
                                    <field name="warehouse_ids" widget="many2many_tags"
                                           options="{'no_create': True}"
                                           placeholder="All warehouses"/>
                                    <field name="location_ids" widget="many2many_tags"
                                           options="{'no_create': True}"
                                           invisible="stock_display != 'location'"
                                           placeholder="Every location holding stock"/>
                                </group>
                            </group>
                        </page>
                        <page string="Display" name="display">
                            <group>
                                <group string="Product Details">
                                    <field name="show_default_code"/>
                                    <field name="show_barcode"/>
                                    <field name="show_description"/>
                                    <field name="show_category"/>
                                </group>
                                <group string="Welcome Screen">
                                    <field name="welcome_title"/>
                                    <field name="welcome_subtitle"/>
                                    <field name="primary_color" widget="color"/>
                                    <field name="background_image" widget="image" class="w-50"/>
                                </group>
                            </group>
                            <group string="Promotions">
                                <field name="promo_interval"/>
                            </group>
                            <field name="promo_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="image" widget="image" options="{'size': [96, 54]}"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                        <page string="Behaviour" name="behaviour">
                            <group>
                                <group string="Idle">
                                    <field name="clear_delay"/>
                                    <field name="reset_lang_on_idle"/>
                                </group>
                                <group string="History">
                                    <field name="history_enabled"/>
                                    <field name="history_limit"
                                           invisible="not history_enabled"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_checker_config_view_list" model="ir.ui.view">
        <field name="name">product.checker.config.list</field>
        <field name="model">product.checker.config</field>
        <field name="arch" type="xml">
            <list string="Price Checker Kiosks">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="default_lang_id"/>
                <field name="stock_display"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="product_checker_config_view_kanban" model="ir.ui.view">
        <field name="name">product.checker.config.kanban</field>
        <field name="model">product.checker.config</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <templates>
                    <t t-name="card" class="flex-row align-items-center">
                        <aside class="me-3">
                            <field name="logo" widget="image" alt="Logo"
                                   options="{'img_class': 'o_image_64_contain'}"/>
                        </aside>
                        <main class="flex-grow-1">
                            <field name="name" class="fw-bold fs-5"/>
                            <field name="company_id" class="text-muted" groups="base.group_multi_company"/>
                            <field name="default_lang_id" class="text-muted"/>
                        </main>
                        <footer class="pt-0 ms-auto">
                            <button name="action_open_kiosk" type="object"
                                    class="btn btn-primary btn-sm"
                                    groups="advanced_product_price_checker.group_price_checker_manager">
                                <i class="fa fa-external-link me-1"/>Open
                            </button>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="product_checker_config_view_search" model="ir.ui.view">
        <field name="name">product.checker.config.search</field>
        <field name="model">product.checker.config</field>
        <field name="arch" type="xml">
            <search string="Price Checker Kiosks">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_product_checker_config" model="ir.actions.act_window">
        <field name="name">Price Checker Kiosks</field>
        <field name="res_model">product.checker.config</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="product_checker_config_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first price checker kiosk</p>
            <p>Each kiosk gets its own secret URL: open it on a tablet or a
               wall-mounted screen and customers can scan products to see prices,
               variants and stock.</p>
        </field>
    </record>

</odoo>
